{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh\" stop",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh\" opening",
            "timeout": 5,
            "statusMessage": "正在拿開場包…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(mcp__apersona__recall|mcp__plugin_apersona_apersona__recall)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh\" receipt",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
