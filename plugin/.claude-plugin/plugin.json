{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "apersona",
  "displayName": "Apersona",
  "version": "0.2.0",
  "description": "本人的規矩、記憶目錄與判讀摘要在開場交給你的 agent；決策點用 MCP 查預註冊的預決策，事後回報結果對照。",
  "author": {
    "name": "eric80522-prog"
  },
  "keywords": [
    "apersona",
    "persona",
    "mcp",
    "pre_decision"
  ],
  "userConfig": {
    "site": {
      "type": "string",
      "title": "伺服器網址（選填）",
      "description": "預設 https://www.apersonaai.com；只有連自己架的伺服器才填。",
      "required": false
    }
  },
  "mcpServers": {
    "apersona": {
      "type": "http",
      "url": "https://www.apersonaai.com/mcp"
    }
  }
}
