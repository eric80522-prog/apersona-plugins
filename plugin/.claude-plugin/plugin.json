{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "apersona",
  "version": "0.2.4",
  "description": "讓你在 Claude Code 少打字：開場就把你的長期規矩交給 AI，AI 做完一段時替你答「繼續做下一項」；需要時用 MCP 查你以前怎麼說、怎麼做。",
  "author": {
    "name": "eric80522-prog"
  },
  "keywords": [
    "apersona",
    "persona",
    "mcp",
    "pre_decision"
  ],
  "userConfig": {
    "site": {
      "type": "string",
      "title": "伺服器網址（選填）",
      "description": "預設 https://www.apersonaai.com；只有連自己架的伺服器才填。",
      "required": false
    }
  },
  "mcpServers": {
    "apersona": {
      "command": "bash",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/hooks/mcp.sh"
      ]
    }
  }
}
