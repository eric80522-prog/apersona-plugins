{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "apersona",
  "version": "0.2.30",
  "icon": "./.claude-plugin/icon.png",
  "description": "在 Claude Code 自動拿開場包和確認收件，並用 MCP 查本人記憶、判讀或手動送資料。",
  "author": {
    "name": "eric80522-prog"
  },
  "keywords": [
    "apersona",
    "persona",
    "mcp",
    "pre_decision"
  ],
  "userConfig": {
    "site": {
      "type": "string",
      "title": "伺服器網址（選填）",
      "description": "預設 https://www.apersonaai.com；只有連自己架的伺服器才填。",
      "required": false
    }
  },
  "mcpServers": {
    "apersona": {
      "command": "bash",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/hooks/mcp.sh"
      ]
    }
  }
}
